# Copy to tools/release/release.env (git-ignored) and fill in.
# Your Apple Developer team ID — the 10 characters in parentheses after your
# "Developer ID Application" certificate: security find-identity -v -p codesigning
TEAM_ID=XXXXXXXXXX
# Certificate used to sign (Developer ID = distribution outside the Mac App Store).
SIGN_IDENTITY="Developer ID Application"
# Name of the notarytool keychain profile (see docs/releasing.md).
NOTARY_PROFILE=MacMoney-notary
